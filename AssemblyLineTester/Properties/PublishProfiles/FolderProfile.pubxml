<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x86</Platform>
    <PublishDir>bin\Release\net10.0-windows\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0-windows</TargetFramework>

    <!--
      win-x86 because Libs\CtaDotNet.dll is 32-bit; a 64-bit process cannot load it.

      Self-contained ships the .NET runtime inside the folder. It costs roughly 70 MB, and it
      removes the single most common reason a customer install refuses to start: the machine not
      having the .NET Desktop Runtime, which fails with a Windows dialog that explains nothing.
      On a handful of factory PCs the disk space is worth less than one support call.
    -->
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>

    <!-- Trimming is off on purpose: WinForms and EF Core both resolve types by reflection, and a
         trimmer has no way to see those references. It would strip something that only fails once
         the operator reaches the screen that needs it. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
